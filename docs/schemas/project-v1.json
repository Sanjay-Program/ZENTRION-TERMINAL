{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentrion.dev/schemas/project-v1.json",
  "title": "Zentrion Project Manifest v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "zentrion.project/v1"},
    "kind": {"const": "Project"},
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$"},
        "version": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"}
        }
      }
    },
    "tools": {"type": "object", "properties": {"include": {"type": "string"}}},
    "ai": {"type": "object", "properties": {"include": {"type": "string"}}},
    "agents": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "policy_inline_or_ref": {"type": "string"}}}},
    "mcp": {"type": "object", "properties": {"servers": {"type": "array", "items": {"type": "string"}}}},
    "permissions": {"type": "object", "properties": {"include": {"type": "string"}}},
    "secrets": {"type": "object", "properties": {"include": {"type": "string"}}},
    "security": {"type": "object", "properties": {"policy": {"type": "string"}}},
    "environment": {"type": "object", "properties": {"include": {"type": "string"}}},
    "platforms": {
      "type": "object",
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "zentrion": {"type": "object", "properties": {"min_version": {"type": "string"}}}
  }
}
