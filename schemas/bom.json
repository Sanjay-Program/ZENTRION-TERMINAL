{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zentrion AI-BOM Schema",
  "type": "object",
  "required": ["bomVersion", "generatedAt", "project", "components"],
  "properties": {
    "bomVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "provider": { "type": "string" },
          "version": { "type": "string" },
          "local": { "type": "boolean" },
          "license": { "type": "string" },
          "id": { "type": "string" },
          "model": { "type": "string" },
          "policy": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "trust": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" },
          "checksum": { "type": "string" },
          "ecosystem": { "type": "string" },
          "location": { "type": "string" },
          "containsPII": { "type": "boolean" },
          "endpoint": { "type": "string" },
          "dataSent": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string" },
          "store": { "type": "string" },
          "everSharedWithAI": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}
